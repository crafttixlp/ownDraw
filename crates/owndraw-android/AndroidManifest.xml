<?xml version="1.0" encoding="utf-8"?>
<!-- OwnDraw für Android. versionCode/versionName setzt build-apk.sh (aus Cargo.toml), minSdk 26, targetSdk 34.
     Keine Speicher-Rechte: Dateien laufen über das Storage Access Framework. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.owndraw">

    <!-- Update-Dienst (WP11): Release-Abfrage/Download und Installation über den PackageInstaller -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="OwnDraw"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="true"
        android:resizeableActivity="true">

        <activity
            android:name="de.owndraw.OwnDrawActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <meta-data android:name="android.app.lib_name" android:value="owndraw" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- „Öffnen mit“ nach MIME-Typ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.owndraw+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-xopp" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- „Teilen an OwnDraw“ -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.owndraw+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-xopp" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- „Öffnen mit“ nach Dateiendung (Dateimanager melden oft application/octet-stream).
                 Mehrere Muster, weil Androids pathPattern bei weiteren Punkten im Pfad sonst nicht greift. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.owndraw" />
                <data android:pathPattern=".*\\..*\\.owndraw" />
                <data android:pathPattern=".*\\..*\\..*\\.owndraw" />
                <data android:pathPattern=".*\\.xopp" />
                <data android:pathPattern=".*\\..*\\.xopp" />
                <data android:pathPattern=".*\\..*\\..*\\.xopp" />
            </intent-filter>
        </activity>

        <!-- Bilder der Zwischenablage und Dateien zum Öffnen in anderen Apps (siehe FileShareProvider.java) -->
        <provider
            android:name="de.owndraw.FileShareProvider"
            android:authorities="de.owndraw.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
