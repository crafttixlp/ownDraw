# Kopieren nach .env (liegt neben docker-compose.yml, nicht ins Repo einchecken).
# Legt beim ersten Start einen Admin an, falls es noch keinen gibt (danach kann der Eintrag entfernt werden).
OWNDRAW_ADMIN_EMAIL=admin@example.org
OWNDRAW_ADMIN_PASSWORD=bitte-ein-langes-passwort

# Optional
# OWNDRAW_DOMAIN=owndraw.thepepelex.at
# OWNDRAW_MAX_BOARD_MB=50
